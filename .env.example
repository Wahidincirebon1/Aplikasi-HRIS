# Local-only Compose setup. Generate fresh secrets before starting.
POSTGRES_USER=hris_user
POSTGRES_PASSWORD=replace_with_random_64_character_secret
POSTGRES_DB=hris_db
JWT_SECRET=replace_with_a_different_random_64_character_secret
ENV=development

# Set once to bootstrap the first superadmin, then remove both values from .env.
# Use a unique email and a randomly generated password of at least 16 characters.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
